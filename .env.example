# Server-only Clerk credentials. Never prefix these with VITE_.
CLERK_SECRET_KEY=sk_test_replace_me

# Your Clerk user ID and/or email. Comma-separate multiple internal operators.
AUTIVEX_ADMIN_USER_IDS=user_replace_me
AUTIVEX_ADMIN_EMAILS=tu-correo@autivexai.com

# Restrict accepted Clerk tokens to the real frontend origins.
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:4184,https://app.autivexai.com
AUTIVEX_APP_URL=http://127.0.0.1:4184

# Existing voice demo integration.
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_AGENT_ID_2=
# Pin numeric draft versions during testing; use Retell tags such as staging/prod after publishing.
RETELL_AGENT_VERSION=
RETELL_AGENT_VERSION_2=

# Existing landing lead delivery.
# Recommended: n8n persists the lead first (for example in Google Sheets).
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM=AutiveX Website <onboarding@autivexai.com>
RESEND_TO=hola@autivexai.com

# Basic protection for public, billable endpoints. Use a durable edge rate limiter at scale.
AUTIVEX_PUBLIC_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4184,https://autivexai.com,https://www.autivexai.com,https://app.autivexai.com
LEAD_RATE_LIMIT_PER_HOUR=4
RETELL_DEMO_RATE_LIMIT_PER_15_MIN=6

# Landing link to the separately deployed dashboard.
VITE_DASHBOARD_URL=http://127.0.0.1:4184
