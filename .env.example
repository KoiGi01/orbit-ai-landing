# Server-only Clerk credentials. Never prefix these with VITE_.
CLERK_SECRET_KEY=sk_test_replace_me

# Server-only Postgres connection. Supabase's pooled connection string works here.
# Never create VITE_DATABASE_URL or expose this value to the browser.
DATABASE_URL=postgresql://postgres.project:password@host:6543/postgres?sslmode=require
# Vercel's native Supabase integration provides POSTGRES_URL automatically.
POSTGRES_URL=
DATABASE_MIGRATION_URL=
DATABASE_SSL=require
DATABASE_POOL_MAX=5

# Local Supabase fallback when DATABASE_URL is not set. Use the Session Pooler on port 5432.
SUPABASE_PROJECT_REF=replace_with_project_ref
SUPABASE_DB_PASSWORD=replace_with_database_password
SUPABASE_DB_POOLER_HOST=aws-0-region.pooler.supabase.com
SUPABASE_DB_POOLER_PORT=5432

# One-time values used by `npm run db:seed:mvp` after migrations are applied.
AUTIVEX_MVP_CLERK_ORG_ID=org_replace_me
AUTIVEX_MVP_WORKSPACE_NAME=AutiveX MVP
AUTIVEX_MVP_TIMEZONE=America/Mexico_City
AUTIVEX_MVP_RETELL_AGENT_ID=
AUTIVEX_MVP_RETELL_AGENT_VERSION=

# Your Clerk user ID and/or email. Comma-separate multiple internal operators.
AUTIVEX_ADMIN_USER_IDS=user_replace_me
AUTIVEX_ADMIN_EMAILS=tu-correo@autivexai.com

# Restrict accepted Clerk tokens to the real frontend origins.
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:4184,https://app.autivexai.com
AUTIVEX_APP_URL=http://127.0.0.1:4184

# Existing voice demo integration.
RETELL_API_KEY=
RETELL_CALENDAR_WEBHOOK_URL=https://autivex-ai.app.n8n.cloud/webhook/retell-calendar
RETELL_DEMO_AGENT_ID=
# Pin a numeric draft version during testing; use a Retell tag after publishing.
RETELL_DEMO_AGENT_VERSION=

# Manual client provisioning. This template supplies voice settings only;
# every paid client gets a separate unpublished draft.
# Optional while RETELL_DEMO_AGENT_ID is configured. When omitted, the demo
# agent supplies the voice/model settings for each new private Location agent.
RETELL_PROVISIONING_TEMPLATE_AGENT_ID=
RETELL_PROVISIONING_LLM_MODEL=gpt-4.1

# Optional shared n8n provisioning workflow. The secret signs the raw JSON body
# in x-autivex-signature; n8n must deduplicate by eventId.
AUTIVEX_PROVISIONING_WEBHOOK_URL=
AUTIVEX_PROVISIONING_WEBHOOK_SECRET=

# Existing landing lead delivery.
# Recommended: n8n persists the lead first (for example in Google Sheets).
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM=AutiveX Website <onboarding@autivexai.com>
RESEND_TO=hola@autivexai.com

# Basic protection for public, billable endpoints. Use a durable edge rate limiter at scale.
AUTIVEX_PUBLIC_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4184,https://autivexai.com,https://www.autivexai.com,https://app.autivexai.com
LEAD_RATE_LIMIT_PER_HOUR=4
RETELL_DEMO_RATE_LIMIT_PER_15_MIN=6

# Dashboard origin override. Leave unset when dashboard routes share the landing domain.
VITE_DASHBOARD_URL=http://127.0.0.1:4184
